{
  "name": "@dnd-dice-roller/infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:stateful": "node scripts/deploy.mjs DiceRollerStateful --require-approval never",
    "deploy:app": "node scripts/deploy.mjs DiceRollerApp --require-approval never",
    "deploy": "node scripts/deploy.mjs --all --require-approval never",
    "destroy": "cdk destroy --all",
    "logs": "node scripts/logs.mjs",
    "logs:characters": "node scripts/logs.mjs characters",
    "logs:macros": "node scripts/logs.mjs macros",
    "logs:sharing": "node scripts/logs.mjs sharing",
    "logs:dndbeyond": "node scripts/logs.mjs dndbeyond",
    "logs:me": "node scripts/logs.mjs me",
    "logs:admin": "node scripts/logs.mjs admin"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.258.0",
    "constructs": "^10.5.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.258.0",
    "esbuild": "^0.25.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
